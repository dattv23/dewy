# Server-only backend URL. Do not expose this value with a NEXT_PUBLIC_ prefix.
BACKEND_URL=

# Canonical public origin used by SEO metadata, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Google OAuth Web client ID used by Google Identity Services in the browser.
# Add the frontend origin (for example http://localhost:3000) to Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
